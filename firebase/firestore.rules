rules_version = '2';

// ============================================================
// VÆGT — Firestore Security Rules
// Deploy: kopiér indhold og indsæt i Firebase Console
//   → Firestore Database → Rules → Publish
// eller via CLI: firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Kun ejeren af sine egne data — og kun hvis email matcher
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId
                        && request.auth.token.email == "larsmollerchristensen@gmail.com";
    }

    // Alt andet: nægt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
